  m_Script: {fileID: 11500000, guid: a990c2f83792fbc4c90a2e3ce64323af, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  text_speed: 0
  curr_text_id: 0
  name_ui: {fileID: 3405278747793970931}
  text_ui: {fileID: 3405278747584022573}
  boss_pic: {fileID: 1888979908266959189}
  dialogue:
  - name: 
    text: "*\uC624\uB298\uC740 \uD734\uAC00 \uBB34\uC778 \uBE44\uD589\uAE30\uB97C
      \uD0C0\uACE0 \uC5EC\uD589\uC744 \uAC00\uACE0\uC788\uB2E4*"
    id: 0
  - name: 
    text: "*\uD2B9\uC218\uC694\uC6D0\uC774 \uD734\uAC00\uAC08\uB550 \uC88B\uC740\uAC70
      \uB9CE\uC774\uC8FC\uB124*"
    id: 0
  - name: "\uBB34\uC804\uAE30"
    text: "\uCE58\uC9C0\uC9C1 \uCE6E\uC9C0----"
    id: 0
  - name: "\uBB34\uC804\uAE30"
    text: "\uC694\uC6D0 14 \uC0AC\uC2E4 \uC774\uAC74 \uD734\uAC00\uAC00 \uC544\uB2C8\uACE0
      \uBBF8\uC158\uC774\uB2E4. "
    id: 0
  - name: "\uBB34\uC804\uAE30"
    text: "\uC544\uB9C8\uC874, \uC774\uC9D1\uD2B8, \uB7EC\uC2DC\uC544\uB85C \uAC00\uC11C"
    id: 1
  - name: "\uBB34\uC804\uAE30"
    text: "3\uB9C8\uB9AC\uC758 \uAD34\uBB3C\uC744 \uCC98\uCE58\uD558\uC5EC\uB77C"
    id: 1
  - name: "\uBB34\uC804\uAE30"
    text: "\uBE44\uD589\uAE30 \uD654\uBB3C\uCE78\uC5D0 \uCD1D\uC774 \uC788\uB2E4"
    id: 2
  - name: ???
    text: "\uAC00\uC838\uAC00\uC11C \uC784\uBB34\uB97C \uC644\uC218\uD558\uB3C4\uB85D!"
    id: 0
  - name: ???
    text: "\uC624\uBC84 \uC564\uB4DC \uC544\uC6C3--\uCE58\uCE58\uCE59--\uB69D"
    id: 0
  - name: 
    text: "*\uD558.....\u3145\u3142*"
    id: 0
